NEXT_PUBLIC_CONVEX_URL=https://efficient-toad-585.eu-west-1.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://efficient-toad-585.eu-west-1.convex.site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set using the Convex CLI after selecting the existing project.
# CONVEX_DEPLOYMENT=
# Server-only key shared with the matching Convex deployment. Never use NEXT_PUBLIC_.
# LEAD_INGEST_SECRET=
# Business details on the Contact page & footer (Vercel). Razorpay's review needs them.
BUSINESS_NAME=Floruvi
# SUPPORT_EMAIL=
# SUPPORT_PHONE=
# BUSINESS_ADDRESS=
# Website chat assistant (Vercel, server-only). Without it, the chat switch shows the
# simple English catalogue guide. See docs/26-chatbot-plan.md.
# OPENROUTER_API_KEY=
# Optional model overrides (defaults: qwen/qwen3.7-flash, then openai/gpt-6-luna).
# OPENROUTER_MODEL=
# OPENROUTER_FALLBACK_MODEL=
# Owner admin panel (/admin). Server-only secret shared with the matching Convex
# deployment (set both: Vercel env + `pnpm exec convex env set ADMIN_API_SECRET`).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ADMIN_API_SECRET=
#
# Convex environment only (not Vercel). See docs/25-admin-and-order-alerts.md.
# ADMIN_CREDENTIAL_HASH=   pnpm -s admin:hash | pnpm exec convex env set ADMIN_CREDENTIAL_HASH [--prod]
# SITE_URL=                e.g. https://floruvi.com (admin link in alerts)
# TELEGRAM_BOT_TOKEN=      from @BotFather
# TELEGRAM_OWNER_CHAT_ID=  your chat or group ID
#
# Razorpay (Convex environment only; see docs/29-razorpay-payments.md). Payments
# also need the owner's switch in /admin. Test keys start with rzp_test_.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET= the secret you type when you add the webhook in Razorpay
