{
  "name": "floruvi-farm",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint app components lib convex --ignore-pattern convex/_generated",
    "test": "node --import tsx --test tests/*.test.ts",
    "convex:dev": "convex dev",
    "convex:seed": "convex run seed:catalogue",
    "admin:hash": "node --import tsx scripts/admin/credential-hash.ts",
    "build:vercel": "convex deploy --cmd 'pnpm build'",
    "format": "prettier --write app components lib convex tests *.ts *.mjs package.json"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.121",
    "@modelcontextprotocol/server": "2.2.0",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "ai": "7.0.118",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "1.46.0",
    "exa-js": "2.25.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.577.0",
    "motion": "^13.5.1",
    "next": "16.4.2",
    "openai": "7.27.0",
    "razorpay": "2.9.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "5.7.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "convex-test": "0.0.60",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.30.3"
}
